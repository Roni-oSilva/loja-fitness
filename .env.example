# Copie para .env.local (desenvolvimento) e configure o mesmo no painel da Vercel (produção).
# Valores abaixo são ilustrativos e NÃO são segredos.

# Público (vai para o navegador). Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
# URL pública do site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PRIVADO — somente servidor. NUNCA prefixar com NEXT_PUBLIC_. Configurar como "Sensitive" na Vercel.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-secreta
